{
  "name": "gatekeeper-search",
  "main": ".wrangler/validate/src/worker.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_als"],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt", "**/*.svg"], "fallthrough": false }
  ],
  // SearchGatekeeper is reached through ctx.exports; no durable_objects binding is required.
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["SearchGatekeeper", "SearchAccountState"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
